{
  "name": "my-collection-backend",
  "version": "1.0.0",
  "description": "Backend de My Collection — TP Final DAI/EFSI 2026",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node db/migrate.js",
    "test": "node --test src/tests/unit/*.test.js",
    "seed": "psql -U $DB_USER -d $DB_NAME -f db/migrations/001_init_v2.sql && psql -U $DB_USER -d $DB_NAME -f db/migrations/002_seed_prueba.sql"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "pg": "8.12.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "nodemon": "3.1.4"
  }
}
